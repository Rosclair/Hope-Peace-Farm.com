{
  "name": "hope-and-peace-farm",
  "version": "0.0.0",
  "private": true,
  "description": "Site vitrine et back-office de Hope & Peace Farm (Bangangté)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copier-standalone.mjs",
    "start": "next start",
    "standalone": "node --env-file-if-exists=.env .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generer": "drizzle-kit generate",
    "db:migrer": "node --env-file-if-exists=.env scripts/migrer.mjs",
    "deploiement:verifier": "node scripts/verifier-deploiement.mjs",
    "site:mesures": "node scripts/mesures-site.mjs",
    "maquette:extraire": "node scripts/extraire-maquette.mjs",
    "maquette:captures": "node scripts/captures-maquette.mjs",
    "maquette:mesures": "node scripts/mesures-maquette.mjs",
    "maquette:diagnostic": "node scripts/diagnostic-maquette.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.2",
    "drizzle-kit": "0.31.11",
    "lighthouse": "13.5.0",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "mysql2": "3.24.5",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  }
}
