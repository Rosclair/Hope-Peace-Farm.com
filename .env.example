# Modèle des variables d’environnement. Copier en .env (jamais versionné) et
# remplir. Chez Hostinger : hPanel → le site → Environment variables (ou
# « Import .env ») ; les variables servent à la compilation et à l’exécution.

# --- Site ---------------------------------------------------------------------
# Adresse publique, sans barre finale.
SITE_URL=http://localhost:3000
# 1 seulement en production sur le vrai domaine (phase 8) ; sinon noindex partout.
SITE_INDEXABLE=0

# --- Base MySQL / MariaDB -----------------------------------------------------
# hPanel → Bases de données → Bases MySQL : nom, utilisateur, mot de passe.
# L’hôte est « localhost » pour une application du même hébergement.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- E-mail (SMTP de la boîte du domaine) -------------------------------------
# Hostinger : smtp.hostinger.com, port 465 (TLS direct).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Vide : déduit du port (465 → TLS direct, sinon STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Vide : "Hope & Peace Farm" <SMTP_USER>. L’adresse doit être celle de la boîte.
MAIL_FROM=
# Adresse qui reçoit les notifications de demandes et les e-mails de test.
NOTIFICATION_EMAIL=

# --- Fichiers téléversés -------------------------------------------------------
# Chemin ABSOLU hors du dossier de déploiement (Hostinger efface hbuilds/ à
# chaque déploiement), par exemple /home/u123456789/domains/<domaine>/televersements
# Vide en développement : uploads/ à la racine du projet.
UPLOAD_DIR=

# --- Secrets (32 caractères au moins) -------------------------------------------
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Jeton du cron : Authorization: Bearer <CRON_SECRET> sur POST /api/taches
CRON_SECRET=
# Jeton du diagnostic : GET /api/sante, POST /api/sante/email
DIAGNOSTIC_SECRET=

# --- Tâches planifiées ---------------------------------------------------------
# Minuteur interne de secours, en minutes (0 = désactivé). Ne remplace pas le
# cron : Hostinger arrête le processus après une période sans trafic.
TACHES_MINUTEUR_MINUTES=0
